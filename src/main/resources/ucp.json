{
  "ucp": {
    "version": "2026-01-23",
    "services": {
      "dev.ucp.shopping": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/overview",
          "transport": "rest",
          "endpoint": "https://yourdomain.com/ucp/v1",
          "schema": "https://ucp.dev/2026-01-23/services/shopping/openapi.json"
        },
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/overview",
          "transport": "mcp",
          "endpoint": "https://yourdomain.com/ucp/mcp",
          "schema": "https://ucp.dev/2026-01-23/services/shopping/openrpc.json"
        },
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/overview",
          "transport": "a2a",
          "endpoint": "https://yourdomain.com/.well-known/agent-card.json"
        },
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/overview",
          "transport": "embedded",
          "schema": "https://ucp.dev/2026-01-23/services/shopping/embedded.json"
        }
      ]
    },
    "capabilities": {
      "dev.ucp.shopping.checkout": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/checkout",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/checkout.json"
        }
      ],
      "dev.ucp.shopping.fulfillment": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/fulfillment",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/fulfillment.json",
          "extends": "dev.ucp.shopping.checkout",
          "config": {
            "supports_multi_group": true,
            "allows_multi_destination": {
              "shipping": true
            }
          }
        }
      ],
      "dev.ucp.shopping.discount": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/discount",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/discount.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ],
      "dev.ucp.shopping.order": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/order",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/order.json",
          "config": {
            "webhook_url": "https://yourdomain.com/webhooks/ucp/orders"
          }
        }
      ],
      "dev.ucp.shopping.catalog": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/catalog",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/catalog.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ],
      "dev.ucp.shopping.buyer_consent": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/buyer-consent",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/buyer-consent.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ],
      "dev.ucp.shopping.ap2_mandate": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/ap2-mandates",
          "schema": "https://ucp.dev/2026-01-23/schemas/shopping/ap2-mandate.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ],
      "dev.ucp.common.identity_linking": [
        {
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/identity-linking",
          "schema": "https://ucp.dev/2026-01-23/schemas/common/identity-linking.json"
        }
      ],
      "com.loyaltyprovider.points": [
        {
          "version": "1.0",
          "spec": "https://loyaltyprovider.com/ucp/points/spec",
          "schema": "https://loyaltyprovider.com/ucp/points/schema.json",
          "extends": "dev.ucp.shopping.checkout"
        }
      ]
    },
    "payment_handlers": {
      "com.google.pay": [
        {
          "id": "gpay_handler_1",
          "version": "2026-01-23",
          "spec": "https://pay.google.com/gp/p/ucp/spec",
          "config_schema": "https://pay.google.com/gp/p/ucp/config.json",
          "instrument_schemas": [
            "https://pay.google.com/gp/p/ucp/instrument.json"
          ],
          "available_instruments": [
            {
              "type": "card",
              "brands": [
                "visa",
                "mastercard",
                "amex",
                "discover"
              ]
            }
          ],
          "config": {
            "api_version": 2,
            "api_version_minor": 0,
            "environment": "PRODUCTION",
            "merchant_info": {
              "merchant_id": "01234567890123456789",
              "merchant_name": "Your Store Name",
              "merchant_origin": "checkout.yourdomain.com"
            },
            "allowed_payment_methods": [
              {
                "type": "CARD",
                "parameters": {
                  "allowed_auth_methods": [
                    "PAN_ONLY",
                    "CRYPTOGRAM_3DS"
                  ],
                  "allowed_card_networks": [
                    "VISA",
                    "MASTERCARD",
                    "AMEX",
                    "DISCOVER"
                  ],
                  "billing_address_required": true,
                  "billing_address_parameters": {
                    "format": "FULL",
                    "phone_number_required": false
                  }
                },
                "tokenization_specification": {
                  "type": "PAYMENT_GATEWAY",
                  "parameters": {
                    "gateway": "stripe",
                    "gatewayMerchantId": "acct_1ABC_your_stripe_id"
                  }
                }
              }
            ],
            "shipping_address_required": false,
            "email_required": true
          }
        }
      ],
      "dev.shopify.shop_pay": [
        {
          "id": "shop_pay_1",
          "version": "2026-01-23",
          "spec": "https://shopify.dev/ucp/handlers/shop_pay",
          "config_schema": "https://shopify.dev/ucp/handlers/shop_pay/config.json",
          "instrument_schemas": [
            "https://shopify.dev/ucp/handlers/shop_pay/instrument.json"
          ],
          "config": {
            "shop_id": "shopify-559128571",
            "environment": "production"
          }
        }
      ],
      "dev.ucp.processor_tokenizer": [
        {
          "id": "processor_tok_1",
          "version": "2026-01-23",
          "spec": "https://ucp.dev/2026-01-23/specification/examples/processor-tokenizer-payment-handler",
          "schema": "https://yourdomain.com/ucp/processor-tokenizer.json",
          "config": {
            "type": "CARD",
            "tokenization_specification": {
              "type": "PUSH",
              "parameters": {
                "token_retrieval_url": "https://api.psp.yourdomain.com/v1/tokens",
                "public_key": "pk_live_your_psp_public_key"
              }
            }
          }
        }
      ],
      "com.example.ap2_handler": [
        {
          "id": "ap2_handler_1",
          "version": "2026-01-23",
          "spec": "https://example.com/specs/ap2-handler",
          "schema": "https://example.com/2026-01-23/schemas/ap2-handler.json"
        }
      ]
    },
    "identity": {
      "oauth2": {
        "authorization_endpoint": "https://accounts.yourdomain.com/oauth/authorize",
        "token_endpoint": "https://accounts.yourdomain.com/oauth/token",
        "revocation_endpoint": "https://accounts.yourdomain.com/oauth/revoke",
        "introspection_endpoint": "https://accounts.yourdomain.com/oauth/introspect",
        "client_id": "gemini_ucp_client",
        "scopes": [
          "profile",
          "address",
          "loyalty",
          "order_history"
        ],
        "pkce_required": true,
        "token_ttl_seconds": 3600,
        "refresh_token_rotation": true
      }
    },
    "signing_keys": [
      {
        "kid": "business_key_2026",
        "kty": "EC",
        "crv": "P-256",
        "x": "WbbXwVYGdJoP4Xm3qCkGvBRcRvKtEfXDbWvPzpPS8LA",
        "y": "sP4jHHxYqC89HBo8TjrtVOAGHfJDflYxw7MFMxuFMPY",
        "use": "sig",
        "alg": "ES256"
      }
    ]
  }
}